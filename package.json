{
  "name": "tenprintsoftware",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TenPrint Software — company website and product catalogue.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:i18n": "node scripts/check_i18n_keys.mjs",
    "sync:versions": "node scripts/sync_product_versions.mjs",
    "build:og": "node scripts/build_og_images.mjs",
    "deploy": "wrangler pages deploy dist --project-name tenprint-software",
    "deploy:report": "wrangler deploy --config wrangler.report.toml",
    "deploy:downloads": "wrangler deploy --config wrangler.downloads.toml"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "astro": "^5.14.1",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
