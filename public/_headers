/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/sitemap.xml
  Cache-Control: public, max-age=3600

/downloads/walkaway/appcast.xml
  Content-Type: application/rss+xml
  Cache-Control: public, max-age=300

/downloads/walkaway/*.zip
  Cache-Control: public, max-age=86400

/downloads/walkaway/*.dmg
  Cache-Control: public, max-age=86400

/downloads/snappyzones/appcast.xml
  Content-Type: application/rss+xml
  Cache-Control: public, max-age=300

/downloads/snappyzones/*.zip
  Cache-Control: public, max-age=86400

/downloads/snappyzones/*.dmg
  Cache-Control: public, max-age=86400

/downloads/sessionguard/appcast.xml
  Content-Type: application/rss+xml
  Cache-Control: public, max-age=300

/downloads/sessionguard/*.zip
  Cache-Control: public, max-age=86400

/downloads/sessionguard/*.dmg
  Cache-Control: public, max-age=86400

/api/*
  Cache-Control: no-store
