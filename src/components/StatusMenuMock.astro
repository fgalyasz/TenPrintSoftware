---
type Props = {
  icon: string;
  status: string;
  rows: readonly string[];
  activeIndex?: number;
  muted?: readonly string[];
  footer?: string;
};

const {
  icon,
  status,
  rows = [],
  activeIndex = 0,
  muted = [],
  footer = "Quit",
} = Astro.props;
---

<div class="mock" aria-hidden="true">
  <div class="mock-bar">
    <img src={icon} alt="" width="18" height="18" />
    <span class="mock-clock mono">{status}</span>
  </div>
  <div class="mock-body">
    {
      rows.map((row, index) => (
        <div class:list={["mock-row", index === activeIndex && "mock-row-active"]}>{row}</div>
      ))
    }
    {muted.length > 0 && <div class="mock-separator"></div>}
    {muted.map((row) => (
      <div class="mock-row mock-row-muted">{row}</div>
    ))}
    <div class="mock-separator"></div>
    <div class="mock-row">{footer}</div>
  </div>
</div>

<style>
  .mock {
    width: min(280px, 100%);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
    font-size: 0.875rem;
  }

  .mock-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
  }

  .mock-bar img {
    border-radius: 5px;
  }

  .mock-clock {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .mock-body {
    display: grid;
    padding: 6px;
  }

  .mock-row {
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
  }

  .mock-row-active {
    color: var(--text);
    background: var(--surface-hover);
  }

  .mock-row-muted {
    color: var(--text-faint);
  }

  .mock-separator {
    height: 1px;
    margin: 5px 10px;
    background: var(--border);
  }
</style>
