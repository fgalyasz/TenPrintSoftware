---
import { localePath, useTranslations } from "~/i18n";
import type { Language } from "~/i18n/config";
import { productCopy } from "~/i18n/products";
import { productStyle, type Product } from "~/data/products";

type Props = { product: Product; language: Language; compact?: boolean };

const { product, language, compact = false } = Astro.props;
const t = useTranslations(language);
const copy = productCopy(product.slug, language);
const modelKey = product.model === "free" ? "product.badge.free" : "product.badge.freemium";
const proTier = product.tiers.find((tier) => tier.kind === "pro");
---

<a
  class:list={["product-card", compact && "product-card-compact"]}
  href={localePath(language, `products/${product.slug}`)}
  style={productStyle(product)}
>
  <span class="product-head">
    <img class="product-icon" src={product.iconUrl} alt="" width="48" height="48" loading="lazy" />
    <span class="product-titles">
      <span class="product-name">{product.name}</span>
      <span class="product-tagline">{copy.tagline}</span>
    </span>
    <span class="product-price mono">
      {proTier ? proTier.price : t("product.pricing.free.price")}
    </span>
  </span>

  {!compact && <span class="product-summary">{copy.summary}</span>}

  <span class="product-meta">
    <span>{t(modelKey)}</span>
    <span aria-hidden="true">·</span>
    <span>{t(product.categoryKey)}</span>
    <span aria-hidden="true">·</span>
    <span class="mono">v{product.version}</span>
  </span>

  <span class="product-action">
    {t("cta.viewProduct")}
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path
        d="M3 7h8M7.5 3.5L11 7l-3.5 3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="square"
        stroke-linejoin="miter"></path>
    </svg>
  </span>
</a>

<style>
  .product-card {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-6) 0;
    border-radius: 0;
    border: 0;
    border-top: 1px solid var(--border);
    background: transparent;
    isolation: isolate;
    transition: border-color 0.2s var(--ease);
  }

  .product-card:hover {
    border-top-color: color-mix(in srgb, var(--product-accent) 55%, var(--border));
  }

  .product-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
  }

  .product-icon {
    border-radius: 9px;
    flex: none;
  }

  .product-titles {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .product-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 450;
    font-optical-sizing: auto;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .product-tagline {
    font-size: 0.875rem;
    color: var(--text-faint);
  }

  .product-price {
    font-size: 0.8125rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .product-summary {
    color: var(--text-muted);
    font-size: 0.9875rem;
    line-height: 1.65;
    max-width: 62ch;
  }

  .product-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45em;
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .product-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
  }

  .product-action svg {
    transition: transform 0.2s var(--ease);
  }

  .product-card:hover .product-action svg {
    transform: translateX(3px);
  }

  .product-card-compact {
    padding: var(--space-5) 0;
    gap: var(--space-3);
  }

  @media (max-width: 560px) {
    .product-head {
      grid-template-columns: auto 1fr;
    }

    .product-price {
      grid-column: 2;
    }
  }
</style>
