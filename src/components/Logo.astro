---
type Props = {
  size?: number;
  withWordmark?: boolean;
  class?: string;
};

const { size = 32, withWordmark = false, class: className = "" } = Astro.props;

const lattice = [
  "M9 9L19 19",
  "M19 19L29 9",
  "M29 9L39 19",
  "M9 29L19 19",
  "M19 19L29 29",
  "M29 29L39 19",
  "M9 29L19 39",
  "M19 39L29 29",
  "M29 29L39 39",
].join("");
---

<span class:list={["logo", className]}>
  <svg
    class="logo-mark"
    width={size}
    height={size}
    viewBox="0 0 48 48"
    role="img"
    aria-label="TenPrint Software"
  >
    <rect x="0" y="0" width="48" height="48" rx="7" fill="var(--brand)"></rect>
    <path
      d={lattice}
      fill="none"
      stroke="#08070c"
      stroke-width="3.4"
      stroke-linecap="square"
      stroke-opacity="0.92"></path>
  </svg>
  {
    withWordmark && (
      <span class="logo-text">
        <span class="logo-name">TenPrint</span>
        <span class="logo-suffix">Software</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
  }

  .logo-mark {
    flex: none;
    border-radius: 7px;
  }

  .logo-text {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    white-space: nowrap;
  }

  .logo-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 480;
    font-optical-sizing: auto;
    letter-spacing: -0.03em;
    color: var(--text);
    line-height: 1;
  }

  .logo-suffix {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  @media (max-width: 420px) {
    .logo-suffix {
      display: none;
    }
  }
</style>
