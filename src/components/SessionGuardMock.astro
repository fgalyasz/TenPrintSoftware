---
type Props = { rows: string[]; activeIndex?: number; muted?: string[]; footer?: string };

const {
  rows = [],
  activeIndex = 3,
  muted = [],
  footer = "Start at Login",
} = Astro.props;
---

<div class="mock" aria-hidden="true">
  <div class="mock-bar">
    <img src="/assets/products/sessionguard.svg" alt="" width="18" height="18" />
    <span class="mock-clock mono">42m</span>
  </div>
  <div class="mock-body">
    {
      rows.map((row, index) => (
        <div class:list={["mock-row", index === activeIndex && "mock-row-active"]}>
          {row}
          {index === activeIndex && <span class="mock-check">✓</span>}
        </div>
      ))
    }
    <div class="mock-separator"></div>
    {muted.map((row) => <div class="mock-row mock-row-muted">{row}</div>)}
    <div class="mock-separator"></div>
    <div class="mock-row">{footer}</div>
  </div>
</div>

<style>
  .mock {
    width: min(300px, 100%);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    font-size: 0.8125rem;
  }

  .mock-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 7px 12px;
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
    border-bottom: 1px solid var(--border);
  }

  .mock-bar img {
    border-radius: 5px;
  }

  .mock-clock {
    font-size: 0.6875rem;
    color: var(--accent-2);
    letter-spacing: 0.02em;
  }

  .mock-body {
    padding: 6px;
    display: grid;
    gap: 1px;
  }

  .mock-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 6px 10px;
    border-radius: 7px;
    color: var(--text-muted);
  }

  .mock-row-active {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--text);
    font-weight: 560;
  }

  .mock-check {
    color: var(--accent-2);
  }

  .mock-row-muted {
    color: var(--text-faint);
  }

  .mock-separator {
    height: 1px;
    background: var(--border);
    margin: 5px 10px;
  }
</style>
