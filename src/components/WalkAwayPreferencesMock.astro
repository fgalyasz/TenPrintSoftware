---
const rows = [
  { label: "Trusted device", value: "Apple Watch" },
  { label: "Away delay", value: "8 s" },
];
---

<div class="plate" aria-hidden="true">
  <div class="bar">Preferences</div>
  {
    rows.map((row) => (
      <div class="row">
        <span>{row.label}</span>
        <span class="mono value">{row.value}</span>
      </div>
    ))
  }
</div>

<style>
  .plate {
    display: grid;
    width: min(340px, 100%);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .bar {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .value {
    font-size: 0.75rem;
    color: var(--text);
  }
</style>
