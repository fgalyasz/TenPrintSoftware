---
import StatusMenuMock from "./StatusMenuMock.astro";
import SnappyZonesDesktopMock from "./SnappyZonesDesktopMock.astro";
import type { Product } from "~/data/products";

type Props = {
  product: Product;
  alt: string;
  caption?: string;
  mockRows?: readonly string[];
  mockMuted?: readonly string[];
};

const { product, alt, caption, mockRows = [], mockMuted = [] } = Astro.props;
const menuStatus = product.slug === "walkaway" ? "Armed" : "42m";
const menuFooter = product.slug === "walkaway" ? "Quit WalkAway" : "Start at Login";
const menuActive = product.slug === "walkaway" ? 0 : 3;
---

{
  product.slug === "snappyzones" ? (
    <div class="visual">
      <span class="visually-hidden">{alt}</span>
      <SnappyZonesDesktopMock caption={caption} />
    </div>
  ) : (
    <div class="visual visual-menu">
      <span class="visually-hidden">{alt}</span>
      <StatusMenuMock
        icon={product.iconUrl}
        status={menuStatus}
        rows={mockRows}
        activeIndex={menuActive}
        muted={mockMuted}
        footer={menuFooter}
      />
      {caption && <p class="caption mono">{caption}</p>}
    </div>
  )
}

<style>
  .visual {
    margin: 0;
    position: relative;
  }

  .visual-menu {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .caption {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }
</style>
