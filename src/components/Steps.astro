---
import type { ProductStep } from "~/i18n/products";

type Props = { steps: ProductStep[]; variant?: "numbered" | "roadmap"; labels?: string[] };

const { steps, variant = "numbered", labels = [] } = Astro.props;
---

<ol class:list={["steps", `steps-${variant}`]}>
  {
    steps.map((step, index) => (
      <li class="step">
        <span class="step-marker">
          {variant === "numbered" ? String(index + 1).padStart(2, "0") : labels[index]}
        </span>
        <div class="step-body">
          <h3 class="title-sm">{step.title}</h3>
          <p class="step-text">{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .steps-numbered,
  .steps-roadmap {
    grid-template-columns: 1fr;
  }

  .step {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    padding: var(--space-6) 0;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
  }

  .steps-roadmap .step {
    grid-template-columns: minmax(12.5rem, 0.34fr) minmax(0, 1fr);
    gap: var(--space-6);
  }

  .step-marker {
    min-width: 0;
    max-width: 100%;
    justify-self: start;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 430;
    font-optical-sizing: auto;
    letter-spacing: -0.03em;
    padding: 0;
    border: 0;
    border-radius: 0;
    color: var(--text-faint);
    background: none;
    text-transform: none;
    line-height: 1.15;
    overflow-wrap: break-word;
  }

  .step-body {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .step-text {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .steps-roadmap .step {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
