---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MazeBackdrop from "~/components/MazeBackdrop.astro";
import ProductCard from "~/components/ProductCard.astro";
import Button from "~/components/Button.astro";
import { localeParams, localePath, useTranslations } from "~/i18n";
import { toLanguage } from "~/i18n/config";
import { sortedProducts } from "~/data/products";

export function getStaticPaths() {
  return localeParams();
}

const language = toLanguage(Astro.params.lang);
const t = useTranslations(language);
const products = sortedProducts();

const badges = [
  t("home.hero.badge.native"),
  t("home.hero.badge.privacy"),
  t("home.hero.badge.oneTime"),
  t("home.hero.badge.notarised"),
];

const principles = [
  { title: t("home.principles.one.title"), text: t("home.principles.one.text") },
  { title: t("home.principles.two.title"), text: t("home.principles.two.text") },
  { title: t("home.principles.three.title"), text: t("home.principles.three.text") },
  { title: t("home.principles.four.title"), text: t("home.principles.four.text") },
];
---

<BaseLayout
  language={language}
  title={t("home.meta.title")}
  description={t("home.meta.description")}
>
  <section class="hero">
    <MazeBackdrop variant="hero" cell={36} />
    <div class="container hero-inner">
      <p class="eyebrow">{t("home.hero.eyebrow")}</p>
      <h1 class="title-xl hero-title">{t("home.hero.title")}</h1>
      <p class="lead hero-lead">{t("home.hero.subtitle")}</p>

      <div class="hero-actions">
        <Button href={localePath(language, "products")} size="lg">{t("cta.explore")}</Button>
        <Button href={localePath(language, "pricing")} variant="secondary" size="lg">
          {t("nav.pricing")}
        </Button>
      </div>

      <p class="hero-meta">{badges.join("  ·  ")}</p>
      <p class="small hero-note">{t("home.hero.note")}</p>
    </div>
  </section>

  <section class="section" id="products">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t("nav.products")}</p>
        <h2 class="title-lg">{t("home.products.title")}</h2>
        <p class="lead">{t("home.products.subtitle")}</p>
      </div>

      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} language={language} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">{t("home.principles.eyebrow")}</p>
        <h2 class="title-lg">{t("home.principles.title")}</h2>
        <p class="lead">{t("home.principles.subtitle")}</p>
      </div>

      <div class="principles">
        {
          principles.map((principle, index) => (
            <article class="principle">
              <span class="principle-index">{String(index + 1).padStart(2, "0")}</span>
              <div class="principle-body">
                <h3 class="title-sm">{principle.title}</h3>
                <p class="principle-text">{principle.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section origin">
    <div class="container origin-grid">
      <div class="origin-copy">
        <p class="eyebrow">{t("home.origin.eyebrow")}</p>
        <h2 class="title-lg origin-title">{t("home.origin.title")}</h2>
        <p class="lead">{t("home.origin.text")}</p>
        <p class="small body-muted">{t("home.origin.caption")}</p>
      </div>

      <div class="origin-panel">
        <MazeBackdrop variant="band" cell={28} />
        <pre class="origin-code mono"><code>10 PRINT CHR$(205.5+RND(1));
20 GOTO 10</code></pre>
      </div>
    </div>
  </section>

  <section class="cta">
    <MazeBackdrop variant="band" cell={32} />
    <div class="container cta-inner">
      <div class="cta-copy">
        <h2 class="title-lg">{t("home.cta.title")}</h2>
        <p class="lead">{t("home.cta.subtitle")}</p>
      </div>
      <div class="cta-actions">
        <Button href={localePath(language, "downloads")} size="lg">{t("cta.download")}</Button>
        <Button href={localePath(language, "support")} variant="secondary" size="lg">
          {t("cta.getSupport")}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(88px, 11vw, 148px) clamp(72px, 8vw, 112px);
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 42rem;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero-title {
    max-width: 14ch;
  }

  .hero-lead {
    max-width: 54ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero-meta {
    margin: var(--space-2) 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text-faint);
  }

  .hero-note {
    color: var(--text-faint);
    max-width: 58ch;
  }

  .product-grid {
    display: grid;
    gap: 0;
    border-bottom: 1px solid var(--border);
  }

  .principles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .principle {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-5);
    align-content: start;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--border);
  }

  .principle:nth-child(odd) {
    padding-right: var(--space-7);
    border-right: 1px solid var(--border);
  }

  .principle:nth-child(even) {
    padding-left: var(--space-7);
  }

  .principle-index {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    font-optical-sizing: auto;
    letter-spacing: -0.04em;
    color: var(--text-faint);
    line-height: 1;
  }

  .principle-body {
    display: grid;
    gap: var(--space-3);
  }

  .principle-text {
    color: var(--text-muted);
    font-size: 0.9875rem;
    line-height: 1.7;
  }

  .origin-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--space-8);
    align-items: center;
  }

  .origin-copy {
    display: grid;
    gap: var(--space-4);
  }

  .origin-title {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .origin-panel {
    position: relative;
    min-height: 320px;
    border-radius: 0;
    border: 1px solid var(--border);
    background: var(--bg-raised);
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: var(--space-6);
  }

  .origin-code {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: var(--space-4) 0;
    border: 0;
    border-block: 1px solid var(--border-strong);
    background: transparent;
    font-size: 0.8125rem;
    line-height: 1.85;
    color: var(--text);
    white-space: pre;
    overflow-x: auto;
  }

  .cta {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--border);
    padding-block: var(--space-9);
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .cta-copy {
    display: grid;
    gap: var(--space-3);
    max-width: 42ch;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (max-width: 880px) {
    .origin-grid,
    .principles {
      grid-template-columns: 1fr;
    }

    .principle:nth-child(odd),
    .principle:nth-child(even) {
      padding-inline: 0;
      border-right: 0;
    }
  }
</style>
