---
import BaseLayout from "~/layouts/BaseLayout.astro";
import MazeBackdrop from "~/components/MazeBackdrop.astro";
import ContactForm from "~/components/ContactForm.astro";
import { localeParams, localePath, useTranslations } from "~/i18n";
import { toLanguage } from "~/i18n/config";
import { productStyle, sortedProducts } from "~/data/products";

export function getStaticPaths() {
  return localeParams();
}

const language = toLanguage(Astro.params.lang);
const t = useTranslations(language);
const products = sortedProducts();

const channels = [
  { title: t("support.channels.faq.title"), text: t("support.channels.faq.text") },
  { title: t("support.channels.update.title"), text: t("support.channels.update.text") },
  { title: t("support.channels.details.title"), text: t("support.channels.details.text") },
];
---

<BaseLayout
  language={language}
  path="support"
  title={t("support.meta.title")}
  description={t("support.meta.description")}
>
  <section class="page-hero">
    <MazeBackdrop variant="panel" cell={32} />
    <div class="container page-hero-inner">
      <p class="eyebrow">{t("nav.support")}</p>
      <h1 class="title-xl">{t("support.title")}</h1>
      <p class="lead">{t("support.subtitle")}</p>
    </div>
  </section>

  <section class="section section-tight">
    <div class="container">
      <div class="section-head">
        <h2 class="title-md">{t("support.channels.title")}</h2>
      </div>
      <div class="channels">
        {
          channels.map((channel, index) => (
            <article class="channel">
              <span class="channel-index">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="title-sm">{channel.title}</h3>
              <p class="channel-text">{channel.text}</p>
            </article>
          ))
        }
      </div>

      <div class="quick-links">
        {
          products.map((product) => (
            <a
              class="quick-link"
              href={`${localePath(language, `products/${product.slug}`)}#faq`}
              style={productStyle(product)}
            >
              <img src={product.iconUrl} alt="" width="30" height="30" />
              <span>{product.name} · {t("product.faq")}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container form-layout">
      <div class="form-side">
        <h2 class="title-lg">{t("cta.getSupport")}</h2>
        <div class="response">
          <h3 class="title-sm">{t("support.response.title")}</h3>
          <p class="small body-muted">{t("support.response.text")}</p>
        </div>
        <p class="small body-muted">{t("form.emailHint")}</p>
      </div>
      <ContactForm language={language} kind="support" />
    </div>
  </section>
</BaseLayout>

<style>
  .channels {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-top: 1px solid var(--border);
  }

  .channel {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6) 0;
    border-radius: 0;
    border: 0;
    border-bottom: 1px solid var(--border);
    background: transparent;
  }

  .channel + .channel {
    padding-left: var(--space-6);
    border-left: 1px solid var(--border);
  }

  .channel-index {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--text-faint);
    letter-spacing: -0.03em;
  }

  .channel-text {
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .quick-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 0;
    margin-right: var(--space-5);
    border-radius: 0;
    border: 0;
    background: none;
    font-size: 0.9375rem;
    color: var(--text-muted);
    transition: color 0.15s var(--ease);
  }

  .quick-link:hover {
    border-color: color-mix(in srgb, var(--product-accent) 45%, transparent);
    color: var(--text);
  }

  .quick-link img {
    border-radius: 8px;
  }

  .form-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .form-side {
    display: grid;
    gap: var(--space-4);
    position: sticky;
    top: calc(var(--header-height) + var(--space-5));
  }

  .response {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 940px) {
    .form-layout,
    .channels {
      grid-template-columns: 1fr;
    }

    .channel + .channel {
      padding-left: 0;
      border-left: 0;
    }

    .form-side {
      position: static;
    }
  }
</style>
