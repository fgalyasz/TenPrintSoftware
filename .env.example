# Cloudflare Pages environment variables for the contact form function.
# Set these in the Pages project (Settings -> Environment variables),
# and locally in .dev.vars when running `wrangler pages dev`.

# Resend API key. Without it the function returns 502 and no mail is sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives support and feedback submissions.
CONTACT_TO=hello@tenprintsoftware.com

# Verified Resend sender. The domain must be verified in Resend.
CONTACT_FROM=TenPrint Software <noreply@tenprintsoftware.com>

# Optional: KV namespace binding named CONTACT_RATE_LIMIT enables rate
# limiting (5 submissions per IP per hour). Without the binding the
# function still works, only without rate limiting.

# Polar webhook signing secret (Standard Webhooks, often prefixed whsec_).
# Without it POST /api/polar returns 503 and Pro purchases are not counted.
POLAR_WEBHOOK_SECRET=whsec_xxxxxxxx
